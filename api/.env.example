# --- Servidor ---
PORT=3000

# --- Base de datos (debe coincidir con el .env de la raíz que usa docker-compose) ---
DATABASE_URL=postgresql://prueba:prueba123@localhost:5432/productos_upc

# --- Autenticación ---
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h

# --- Carga inicial (npm run seed, opcional) ---
# Ruta al CSV relativa a la carpeta api/. Por defecto: ../data/productos.csv
# SEED_CSV_PATH=../data/productos.csv
