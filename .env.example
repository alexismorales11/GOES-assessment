# --- Base de datos (usadas por docker-compose.yml) ---
POSTGRES_DB=productos_upc
POSTGRES_USER=prueba
POSTGRES_PASSWORD=prueba123
POSTGRES_PORT=5432

# Cadena de conexión de referencia para la API
DATABASE_URL=postgresql://prueba:prueba123@localhost:5432/productos_upc

# --- Autenticación (para tu API NestJS) ---
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h
